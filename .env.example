# Baidu Qianfan DeepSeek-OCR (server only)
QIANFAN_API_KEY=bce-v3/replace-with-current-key
QIANFAN_OCR_MODEL=deepseek-ocr

# Optional: set only when the Qianfan API Key is restricted to an AppID.
QIANFAN_APP_ID=

# DeepSeek structuring, diagnosis, and independent review (server only)
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Recommended: a separate random secret for short-lived evidence tokens.
# When omitted, the server derives a purpose-bound signing key from DEEPSEEK_API_KEY.
EVIDENCE_SIGNING_SECRET=

# Administrator operations dashboard (server only)
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
VERCEL_TOKEN=replace-with-a-read-only-expiring-token
VERCEL_PROJECT_ID=prj_replace-with-project-id
# Optional for projects owned by a Vercel team.
VERCEL_TEAM_ID=
