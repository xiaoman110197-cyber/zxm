{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze-file.js": {
      "maxDuration": 180,
      "includeFiles": "{node_modules/tesseract.js/src/worker-script/node/**,node_modules/tesseract.js-core/**,node_modules/@tesseract.js-data/chi_sim/**}"
    },
    "api/diagnosis.js": { "maxDuration": 45 },
    "api/report.js": { "maxDuration": 45 },
    "api/health.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'" }
      ]
    }
  ]
}
